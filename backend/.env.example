# ---------------------------------------------------------------------------
# csmju-coop-hours-calculator - ตัวอย่าง environment (คัดลอกเป็น .env, ห้าม commit .env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4210

# ฐานข้อมูลของระบบย่อยนี้เท่านั้น - ห้ามชี้ไปที่ฐานของ Core Hub
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csmju_coop_hours_calculator?schema=public
# จำนวน connection สูงสุดต่อระบบ (PostgreSQL ตัวกลางใช้ร่วมกันหลายระบบ) — deployment.md ข้อ 4.1
DATABASE_POOL_MAX=5

# Core Hub จริง (standards docs/connect-core-hub.md)
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# สัญญา JWT ที่ตรึงไว้ - ห้ามเปลี่ยนเอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# ชื่อใน Subsystem Registry (ใช้ตั้งชื่อคุกกี้ด้วย)
SUBSYSTEM_ID=csmju-coop-hours-calculator
SUBSYSTEM_NAME=ระบบติดตามชั่วโมงสหกิจและกิจกรรม

# เขตเวลาของ container (tech-stack.md ข้อ 1.4.1)
TZ=Asia/Bangkok
