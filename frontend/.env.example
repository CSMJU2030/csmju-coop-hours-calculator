# NestJS backend ของระบบนี้ (ฝั่ง server เท่านั้น) - frontend ห้ามมี DATABASE_URL
# ถูกฝังตอน next build (rewrites) จึงตั้งตอนรัน container ไม่มีผล — ใน image คือ http://api:4000
BACKEND_URL=http://127.0.0.1:4210
# ต้องตรงกับ SUBSYSTEM_ID ของ backend และ name ใน Subsystem Registry
SUBSYSTEM_ID=csmju-coop-hours-calculator
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
